{"id":"ld1-1643400021979-1643400033903-0","version":"","unitCode":"NASM","linkedId":"","type":"edanmdm","content":{"freetext":{"name":[{"label":"Manufacturer","content":"Boeing Aerospace Company"}],"notes":[{"label":"Physical Description","content":"Flight test model #2 of cruise missile designed to be air-launched from B-52 and B1B bombers."},{"label":"Summary","content":"This is the AGM-86B, the second version of the U.S. Air Force's air-launched cruise missile (ALCM) and built by Boeing. Launched from B-52 bombers, the missile had a nuclear warhead, a turbofan jet engine, a range of approximately 2,400 km (1,500 miles), and two navigation systems that enabled it to fly close to the ground making it difficult for enemy radars to pick up. First deployed in 1982, some of the missiles began to be converted in 1986 to the AGM-86C with a conventional warhead and a Global Positioning System-aided navigation system. This missile was the second flight model tested and was transferred to NASM by the U.S. Air Force in 1982."}],"place":[{"label":"Country of Origin","content":"United States of America"}],"setName":[{"label":"See more items in","content":"National Air and Space Museum Collection"},{"label":"Location","content":"Steven F. Udvar-Hazy Center in Chantilly, VA"},{"label":"Exhibit Station","content":"Rockets & Missiles"}],"creditLine":[{"label":"Credit Line","content":"Transferred from the United States Air Force"}],"dataSource":[{"label":"Data Source","content":"National Air and Space Museum"}],"identifier":[{"label":"Inventory Number","content":"A19820121000"}],"objectType":[{"label":"Type","content":"ARMAMENT-Missiles"}],"objectRights":[{"label":"Restrictions & Rights","content":"CC0"}],"physicalDescription":[{"label":"Materials","content":"Body: metal Umbillical connector: plastic"},{"label":"Dimensions","content":"Overall: 4 ft. 6 in. tall x 20 ft. 10 in. long, 1100 lb. (137.1 x 635cm, 499kg)"}]},"indexedStructured":{"name":["Boeing Aerospace Company"],"place":["United States of America"],"topic":["War"],"exhibition":[{"building":"HAZY"}],"usage_flag":["Space","Missiles","Military"],"geoLocation":[{"L2":{"type":"Country","content":"United States of America"}}],"object_type":["Missiles","Weapons"],"onPhysicalExhibit":["Yes"],"online_media_type":["Images"]},"descriptiveNonRepeating":{"guid":"http://n2t.net/ark:/65665/nv94c0f0ad1-9108-476e-b4d0-eeecff910345","title":{"label":"Object Name","content":"Missile, Cruise, Air-launched, Flight Test, AGM-86B ALCM"},"record_ID":"nasm_A19820121000","unit_code":"NASM","title_sort":"MISSILE, CRUISE, AIR-LAUNCHED, FLIGHT TEST, AGM-86B ALCM","data_source":"National Air and Space Museum","record_link":"http://n2t.net/ark:/65665/nv94c0f0ad1-9108-476e-b4d0-eeecff910345","online_media":{"media":[{"id":"media:NASM-A19820121000-NASM2019-00593","guid":"http://n2t.net/ark:/65665/gf4d17398cf-a4e5-4082-95db-12476b1432ff","type":"Images","idsId":"NASM-A19820121000-NASM2019-00593","usage":{"access":"CC0"},"width":8272,"height":6200,"content":"https://ids.si.edu/ids/deliveryService?id=NASM-A19820121000-NASM2019-00593","maxsize":0,"thumbnail":"https://ids.si.edu/ids/deliveryService?id=NASM-A19820121000-NASM2019-00593","altTextAccessibility":"Metallic gray flight test model with US AIR FORCE inscription","extDescrAccessibility":"Flight test model #2 of cruise missile designed to be air-launched from B-52 and B1B bombers.","resources":[{"label":"High-resolution TIFF","url":"https://ids.si.edu/ids/download?id=NASM-A19820121000-NASM2019-00593.tif","width":8272,"height":6200,"dimensions":"8272x6200"},{"label":"High-resolution JPEG","url":"https://ids.si.edu/ids/download?id=NASM-A19820121000-NASM2019-00593.jpg","width":8272,"height":6200,"dimensions":"8272x6200"},{"label":"Screen Image","url":"https://ids.si.edu/ids/download?id=NASM-A19820121000-NASM2019-00593_screen"},{"label":"Thumbnail Image","url":"https://ids.si.edu/ids/download?id=NASM-A19820121000-NASM2019-00593_thumb"}]},{"id":"media:NASM-A1982012100