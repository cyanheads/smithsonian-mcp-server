{
  "name": "smithsonian-mcp-server",
  "version": "0.3.5",
  "description": "Search 14.5M Smithsonian Open Access objects across 20+ museums via MCP, and retrieve CC0 images for the 5.2M that carry openly-licensed media. STDIO or Streamable HTTP.",
  "author": {
    "name": "Casey Hand"
  },
  "homepage": "https://github.com/cyanheads/smithsonian-mcp-server#readme",
  "repository": "https://github.com/cyanheads/smithsonian-mcp-server",
  "license": "Apache-2.0",
  "mcpServers": {
    "smithsonian-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/smithsonian-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "SMITHSONIAN_API_KEY": "your-api-key"
      }
    }
  }
}
